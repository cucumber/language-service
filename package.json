{
  "name": "@cucumber/language-service",
  "version": "1.7.0",
  "description": "Cucumber Language Service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "enginesTested": {
    "node": "22 || 24 || 26"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/WasmParserAdapter.d.ts",
      "default": "./dist/WasmParserAdapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "fix": "biome check --fix --error-on-warnings",
    "lint": "biome check --error-on-warnings",
    "postbuild": "node -e \"require('.')\"",
    "prepare": "husky && node scripts/build.js && cp node_modules/web-tree-sitter/web-tree-sitter.wasm dist",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "mocha"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/cucumber/language-service.git"
  },
  "keywords": [
    "cucumber",
    "lsp",
    "language service"
  ],
  "author": "Cucumber Limited <cukes@googlegroups.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cucumber/language-service/issues"
  },
  "homepage": "https://github.com/cucumber/language-service#readme",
  "contributors": [
    "Binh Duc Tran <binhtran432k@gmail.com>",
    "David Goss (https://github.com/davidjgoss)",
    "Kieran Ryan <kierankilkenny@gmail.com>",
    "M.P. Korstanje <rien.korstanje@gmail.com>",
    "Miro <miroslav.sommer@gmail.com>"
  ],
  "lint-staged": {
    "*": "biome check --fix --no-errors-on-unmatched --error-on-warnings"
  },
  "dependencies": {
    "@cucumber/cucumber-expressions": "^20.0.0",
    "@cucumber/gherkin": "^42.0.0",
    "@cucumber/gherkin-utils": "^12.0.0",
    "@cucumber/messages": "^34.0.0",
    "@types/js-search": "1.4.4",
    "@types/mustache": "4.2.6",
    "fuse.js": "7.5.0",
    "js-search": "2.0.1",
    "mustache": "4.2.0",
    "vscode-languageserver-types": "3.18.5",
    "web-tree-sitter": "^0.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cucumber/biome-config": "github:cucumber/biome-config#v0.6.0",
    "@cucumber/cucumber": "^13.0.0",
    "@cucumber/message-streams": "^5.0.0",
    "@tsconfig/recommended": "^1.0.13",
    "@types/glob": "9.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "glob": "14.0.3",
    "husky": "9.1.7",
    "lint-staged": "^17.0.0",
    "mocha": "12.0.3",
    "node-gyp": "^13.0.0",
    "react": "19.3.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cli": "0.27.1",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "0.23.2",
    "ts-node": "10.9.2",
    "txtgen": "3.0.7",
    "typescript": "^6.0.3"
  }
}
